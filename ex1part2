from mrjob.step import MRStep
from mrjob.job import MRJob
import string

class WordCountSorted(MRJob):

    def steps(self):
        return [
            MRStep(mapper=self.mapper_get_words, reducer=self.reducer_count_words),
            MRStep(mapper=self.mapper_swap, reducer=self.reducer_sort)
        ]

    def mapper_get_words(self, _, line):
        for word in line.split():
            # Nettoyage basique pour enlever la ponctuation (comme vu précédemment)
            clean_word = word.lower().strip(string.punctuation)
            if clean_word:
                yield clean_word, 1

    def reducer_count_words(self, word, counts):
        yield word, sum(counts)

    def mapper_swap(self, word, count):
        # POUR L'ORDRE CROISSANT : yield count, word
        # POUR L'ORDRE DÉCROISSANT : yield -count, word (le signe moins inverse le tri)
        yield count, word 

    def reducer_sort(self, count, words):
        for word in words:
            yield word, count

if __name__ == '__main__':
    WordCountSorted.run()
