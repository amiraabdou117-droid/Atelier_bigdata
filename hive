create database if not exists banque;
use banque;

-- On supprime la ligne 'loan_percent' qui n'existe pas dans le CSV
-- On remplace 'long' par 'bigint'
create external table credits(
    person_age int,
    person_income bigint,
    person_home_ownership String,
    person_emp_length double,
    loan_intent chararray,
    loan_grade chararray,
    loan_amnt double,
    loan_int_rate double,
    loan_status int,
    loan_percent_income double,
    cb_person_default_on_file String,
    cb_person_cred_hist_length int
)
ROW FORMAT DELIMITED FIELDS TERMINATED BY ','
TBLPROPERTIES('skip.header.line.count'='1');

-- Chargement des données
LOAD DATA INPATH '/user/uti/credit_risk_dataset.csv' INTO TABLE credits;
